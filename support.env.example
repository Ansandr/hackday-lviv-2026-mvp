# Copy into your local .env, or export these variables. Never commit real keys.
# demo: deterministic UI fixtures; remote: connect the agent and SaaS adapters.
SUPPORT_MODE=demo
SUPPORT_DB=support.sqlite3
SUPPORT_AGENT_URL=http://127.0.0.1:8010
SUPPORT_SAAS_URL=http://127.0.0.1:8020
SUPPORT_SERVICE_KEY=replace-with-shared-service-secret
# In remote mode, replace these credentials. Each key is a login access code.
SUPPORT_ACCOUNTS={"replace-owner-a-code":{"tenant_id":"tenant_a","actor_id":"owner_a","role":"owner"},"replace-owner-b-code":{"tenant_id":"tenant_b","actor_id":"owner_b","role":"owner"}}

# Integrated one-process mode (python -m src.support.run):
# SUPPORT_MODE=integrated
# Explicit first-run fallbacks, no MongoDB or vector embeddings needed:
SUPPORT_PRODUCT_STORE=sqlite
SUPPORT_PRODUCT_DB=product.sqlite3
SUPPORT_RAG_MODE=files
# Set SUPPORT_RAG_MODE=atlas and SUPPORT_PRODUCT_STORE=mongo for the team's MongoDB.
# SUPPORT_LLM=local selects Ollama even when an API key exists.
SUPPORT_LLM=api
SUPPORT_PORT=8000
